{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sukien",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sukien-db",
      "database_id": "f5ce2d76-abe4-46cf-a594-7c525f048804"
    }
  ]
}